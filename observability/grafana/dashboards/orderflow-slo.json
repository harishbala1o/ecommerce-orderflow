{
  "uid": "orderflow-slo",
  "title": "OrderFlow — SLOs & Error Budget",
  "tags": ["orderflow", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Availability SLI (30m) — target 99.5%",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green", "value": 0.995 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "orderflow:availability_sli:30m"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency SLI (30m) — target 95% < 0.5s",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "orderflow:latency_sli:30m"
        }
      ]
    },
    {
      "id": 3,
      "title": "Fast-burn error ratio (1h) vs page threshold (7.2%)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "orderflow:error_ratio:1h or vector(0)",
          "legendFormat": "error ratio 1h"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "vector(0.072)",
          "legendFormat": "page threshold"
        }
      ]
    },
    {
      "id": 4,
      "title": "Error ratio by window (server_error / total)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "orderflow:error_ratio:5m or vector(0)", "legendFormat": "5m" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "orderflow:error_ratio:30m or vector(0)", "legendFormat": "30m" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "orderflow:error_ratio:1h or vector(0)", "legendFormat": "1h" }
      ]
    },
    {
      "id": 5,
      "title": "Requests by outcome (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(orderflow_action_duration_seconds_count[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
