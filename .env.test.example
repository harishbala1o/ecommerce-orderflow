# Template for the ISOLATED TEST STACK (project name: orderflow-test).
#
# Copy to .env.test with freshly generated local-only secrets:
#     make test-env
#
# .env.test is gitignored. The placeholders below are not credentials; the
# generator replaces every CHANGE_ME with random bytes from openssl.
#
# Everything here is deliberately named differently from the dev stack so the
# two can run side by side and `make test-reset` cannot touch dev data.

# Postgres (published on host port 55432)
POSTGRES_USER=orderflow_test
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=orderflow_test

# Hasura (published on host port 18080)
HASURA_GRAPHQL_ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET
HASURA_GRAPHQL_DATABASE_URL=postgres://orderflow_test:CHANGE_ME_POSTGRES@postgres:5432/orderflow_test
PG_DATABASE_URL=postgres://orderflow_test:CHANGE_ME_POSTGRES@postgres:5432/orderflow_test

# Shared secret between Hasura and the services. Never reaches the browser.
ACTION_SECRET=CHANGE_ME_ACTION_SECRET

# Keycloak (published on host port 18081, realm `orderflow-test`)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK

# Inventory bounded context: its own database in the same test instance.
INVENTORY_DATABASE_URL=postgres://orderflow_test:CHANGE_ME_POSTGRES@postgres:5432/orderflow_test_inventory
INVENTORY_URL=http://inventory-service:3002
