# Template pointing the dashboard at the ISOLATED test stack (13000/18080/18081).
# Copy to .env.local before running `pnpm dev:test`:
#     cp .env.test.example .env.local
# Local-only values, not secrets. Real .env.local files stay gitignored, in
# line with the convention in SECURITY.md.
NEXTAUTH_URL=http://localhost:13000
NEXTAUTH_SECRET=orderflow_test_only_nextauth_secret
KEYCLOAK_ISSUER=http://localhost:18081/realms/orderflow-test
KEYCLOAK_CLIENT_ID=web
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:18080/v1/graphql
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:18081/realms/orderflow-test
